# Beispielkonfiguration (ohne echte Werte). Kopie als .env anlegen; .env wird nicht eingecheckt.

# URL der chayns.codes-Bridge auf der Lansing-Site (https://run.chayns.codes/<id>)
BRIDGE_URL=
# Gemeinsames Geheimnis Container <-> Bridge, mind. 32 Zeichen, z. B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SECRET=

# UAC-Gruppen der Lansing-Site (kommagetrennt möglich)
UAC_GROUP_TEAM=79077
UAC_GROUP_ADMIN=223675

# E-Mail-Kopie an den Auftraggeber (leer = kein Versand). Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absender (Standard: SMTP_USER) und Anzeigename
MAIL_FROM=
MAIL_FROM_NAME=LANSING Metallbau – Bautagesbericht
# Antwortadresse für Rückfragen (z. B. Büro Lansing) und optionale Blindkopie (Ablage)
MAIL_REPLY_TO=
MAIL_BCC=
# Größere PDFs werden nicht per Mail verschickt
MAIL_MAX_MB=20

# Nur für lokale Tests: Anmeldung ohne chayns. Dafür zusätzlich NODE_ENV=development setzen.
# NIE in Produktion verwenden.
DEV_LOGIN=false
NODE_ENV=production
